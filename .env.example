# Optional. Without it, the app still scans Polymarket for internal arbitrage
# (both outcomes of a game summing to under $1) using only public Polymarket data.
# Set it to also compare Polymarket's price against sportsbook consensus odds.
# Free tier (500 req/mo) at https://the-odds-api.com
ODDS_API_KEY=

# Optional. Read-only access to your real polymarket.us balance/positions
# ("My account" panel) and real-money bet-sizing suggestions. Generate at
# polymarket.us/developer. Never required for paper trading, which only
# uses public market data.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Optional, deploy-only. Without these, state (paper-trading bankrolls, the
# cached scan) lives in local data/*.json files — fine for local use. Set
# both to a free Upstash Redis REST database (upstash.com) so state survives
# a serverless host's ephemeral filesystem and syncs across devices — see
# README "Deploy" section. Reuses the same free-tier database as this
# project's siblings (portfolio-dashboard, financial-growth-analyzer) is
# fine; this project namespaces its own keys under "polymarket-bet-calculator:".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
